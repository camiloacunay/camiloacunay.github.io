---
import "../../styles/global.css";

const dashboardUrl =
  "https://app.powerbi.com/view?r=eyJrIjoiY2FmYTExMjUtZGVjMi00YjRhLWFiMTctMjQ2MjVkMGVhOTVlIiwidCI6ImUyMDIzYzZiLTI3NDgtNDM2ZS1hZGU3LTk0MjZhZDFlMDZjNSJ9";

const kpis = [
  {
    title: "Ingresos",
    description: "Monto total generado por las ventas del período analizado."
  },
  {
    title: "Ventas",
    description: "Cantidad total de transacciones registradas."
  },
  {
    title: "Ticket promedio",
    description: "Valor promedio por operación comercial."
  },
  {
    title: "Clientes",
    description: "Cantidad de clientes únicos identificados en la base."
  }
];

const processSteps = [
  {
    number: "01",
    title: "Preparación de datos",
    description:
      "Revisión de campos, tipos de datos, fechas, productos, clientes, regiones, categorías y métodos de pago para asegurar una estructura consistente antes del análisis."
  },
  {
    number: "02",
    title: "Modelado en Power BI",
    description:
      "Construcción del modelo analítico, creación de relaciones, medidas DAX e indicadores comerciales para analizar ingresos, ventas, ticket promedio, unidades y clientes."
  },
  {
    number: "03",
    title: "Visualización ejecutiva",
    description:
      "Diseño de una vista clara con KPIs superiores, evolución mensual, análisis por categoría, ranking de productos, filtros dinámicos y visualizaciones de composición."
  }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Dashboard Comercial Retail 2024 | Camilo Acuña</title>
    <meta
      name="description"
      content="Caso de estudio de dashboard comercial desarrollado en Power BI para analizar ventas, ingresos, productos, clientes, regiones y métodos de pago."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="min-h-screen bg-[#080D18] text-slate-100 antialiased">
    <main class="min-h-screen overflow-hidden bg-[radial-gradient(circle_at_top_left,rgba(56,189,248,0.18),transparent_34%),radial-gradient(circle_at_top_right,rgba(99,102,241,0.16),transparent_32%),linear-gradient(180deg,#080D18_0%,#0F172A_50%,#080D18_100%)]">
      
      <!-- Header -->
      <header class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-8">
        <a
          href="/"
          class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-300 transition hover:border-cyan-400/50 hover:text-white"
        >
          ← Volver al portafolio
        </a>

        <a
          href="/CV_Camilo_A.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-300 transition hover:border-cyan-400/50 hover:text-white"
        >
          Ver CV
        </a>
      </header>

      <!-- Hero -->
      <section class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-12 lg:grid-cols-[0.95fr_1.05fr] lg:px-8 lg:py-20">
        <div>
          <p class="mb-5 inline-flex rounded-full border border-cyan-400/30 bg-cyan-400/10 px-4 py-2 text-sm font-semibold text-cyan-300">
            Business Intelligence · Power BI · Data Analytics
          </p>

          <h1 class="max-w-4xl text-4xl font-bold tracking-tight text-white md:text-6xl">
            Dashboard Comercial Retail 2024
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
            Proyecto de análisis y visualización desarrollado en Power BI para monitorear
            el desempeño comercial de una operación retail. El dashboard permite analizar
            ingresos, ventas, ticket promedio, unidades vendidas, clientes, categorías,
            regiones, productos y métodos de pago mediante indicadores ejecutivos y filtros
            dinámicos.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <span class="rounded-full bg-white/10 px-4 py-2 text-sm text-slate-200">Power BI</span>
            <span class="rounded-full bg-white/10 px-4 py-2 text-sm text-slate-200">DAX</span>
            <span class="rounded-full bg-white/10 px-4 py-2 text-sm text-slate-200">Power Query</span>
            <span class="rounded-full bg-white/10 px-4 py-2 text-sm text-slate-200">Modelado de datos</span>
            <span class="rounded-full bg-white/10 px-4 py-2 text-sm text-slate-200">KPIs</span>
          </div>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href={dashboardUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-xl bg-cyan-400 px-5 py-3 font-semibold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:bg-cyan-300"
            >
              Ver dashboard en Power BI
            </a>

            <a
              href="#proceso"
              class="rounded-xl border border-white/10 bg-white/5 px-5 py-3 font-semibold text-slate-200 transition hover:border-cyan-400/60 hover:text-white"
            >
              Ver proceso técnico
            </a>
          </div>
        </div>

        <!-- Dashboard preview -->
        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-3 shadow-2xl shadow-black/40">
          <div class="overflow-hidden rounded-2xl border border-white/10 bg-slate-950">
            <iframe
              title="Dashboard Comercial Retail 2024"
              src={dashboardUrl}
              class="h-[360px] w-full md:h-[430px] lg:h-[470px]"
              frameborder="0"
              allowfullscreen
            >
            </iframe>
          </div>

          <p class="px-2 pt-3 text-sm text-slate-400">
            Vista interactiva del dashboard publicado en Power BI.
          </p>
        </div>
      </section>

      <!-- Summary cards -->
      <section class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
        <div class="grid gap-4 md:grid-cols-4">
          <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5">
            <p class="text-sm text-slate-400">Área</p>
            <p class="mt-2 text-lg font-semibold text-white">Retail</p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5">
            <p class="text-sm text-slate-400">Herramienta</p>
            <p class="mt-2 text-lg font-semibold text-white">Power BI</p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5">
            <p class="text-sm text-slate-400">Foco</p>
            <p class="mt-2 text-lg font-semibold text-white">Ventas</p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5">
            <p class="text-sm text-slate-400">Tipo</p>
            <p class="mt-2 text-lg font-semibold text-white">Dashboard ejecutivo</p>
          </div>
        </div>
      </section>

      <!-- Context -->
      <section class="mx-auto grid max-w-7xl gap-8 px-6 py-12 lg:grid-cols-[0.75fr_1.25fr] lg:px-8">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-cyan-300">Contexto</p>
          <h2 class="mt-3 text-3xl font-bold text-white">Problema abordado</h2>
        </div>

        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-8">
          <p class="leading-8 text-slate-300">
            En una operación comercial, los datos de ventas pueden estar disponibles, pero no siempre
            están organizados para responder preguntas de negocio de forma rápida. El objetivo del
            proyecto fue transformar una base de ventas en un tablero ejecutivo que permitiera analizar
            cuánto se vendió, qué productos explican los ingresos, qué categorías concentran mayor valor,
            qué regiones tienen mejor desempeño y cómo se distribuyen los métodos de pago.
          </p>
        </div>
      </section>

      <!-- KPIs -->
      <section class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-8">
          <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-cyan-300">Indicadores</p>
              <h2 class="mt-3 text-3xl font-bold text-white">KPIs principales</h2>
              <p class="mt-4 text-slate-400">
                El dashboard se diseñó para entregar una vista ejecutiva rápida del desempeño comercial.
              </p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              {kpis.map((kpi) => (
                <div class="rounded-2xl border border-white/10 bg-slate-950/60 p-5">
                  <p class="font-semibold text-white">{kpi.title}</p>
                  <p class="mt-2 text-sm leading-6 text-slate-400">{kpi.description}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Technical process -->
      <section id="proceso" class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
        <div class="mb-10">
          <p class="text-sm font-semibold uppercase tracking-widest text-cyan-300">Proceso técnico</p>
          <h2 class="mt-3 text-3xl font-bold text-white">De datos brutos a dashboard ejecutivo</h2>
        </div>

        <div class="grid gap-6 lg:grid-cols-3">
          {processSteps.map((step) => (
            <article class="rounded-3xl border border-white/10 bg-white/[0.04] p-7 transition hover:border-cyan-400/40 hover:bg-white/[0.07]">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-cyan-400 text-sm font-bold text-slate-950">
                {step.number}
              </div>

              <h3 class="mt-5 text-xl font-semibold text-white">{step.title}</h3>

              <p class="mt-3 leading-7 text-slate-300">
                {step.description}
              </p>
            </article>
          ))}
        </div>
      </section>

      <!-- Analysis dimensions -->
      <section class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
        <div class="grid gap-8 lg:grid-cols-2">
          <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-8">
            <p class="text-sm font-semibold uppercase tracking-widest text-cyan-300">
              Análisis
            </p>

            <h2 class="mt-3 text-3xl font-bold text-white">
              Dimensiones exploradas
            </h2>

            <ul class="mt-6 space-y-3 text-slate-300">
              <li>• Evolución mensual de ingresos.</li>
              <li>• Ingresos por categoría de producto.</li>
              <li>• Ranking de productos con mayor aporte comercial.</li>
              <li>• Distribución de métodos de pago.</li>
              <li>• Análisis por región, fecha y categoría.</li>
              <li>• Estado de ventas y comportamiento operacional.</li>
            </ul>
          </div>

          <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-8">
            <p class="text-sm font-semibold uppercase tracking-widest text-cyan-300">
              Resultado
            </p>

            <h2 class="mt-3 text-3xl font-bold text-white">
              Valor del proyecto
            </h2>

            <p class="mt-6 leading-8 text-slate-300">
              El tablero permite detectar patrones de venta, identificar categorías relevantes,
              priorizar productos de alto impacto y facilitar una lectura ejecutiva del desempeño
              comercial. El resultado es una herramienta visual y accionable para apoyar decisiones
              de negocio.
            </p>
          </div>
        </div>
      </section>

      <!-- Skills applied -->
      <section class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-8">
          <p class="text-sm font-semibold uppercase tracking-widest text-cyan-300">
            Competencias aplicadas
          </p>

          <h2 class="mt-3 text-3xl font-bold text-white">
            Qué demuestra este proyecto
          </h2>

          <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            <div class="rounded-2xl bg-slate-950/60 p-5">
              <p class="font-semibold text-white">Diseño de KPIs</p>
              <p class="mt-2 text-sm leading-6 text-slate-400">
                Definición de métricas relevantes para evaluar desempeño comercial.
              </p>
            </div>

            <div class="rounded-2xl bg-slate-950/60 p-5">
              <p class="font-semibold text-white">Modelado de datos</p>
              <p class="mt-2 text-sm leading-6 text-slate-400">
                Organización de información para análisis en Power BI.
              </p>
            </div>

            <div class="rounded-2xl bg-slate-950/60 p-5">
              <p class="font-semibold text-white">Visualización ejecutiva</p>
              <p class="mt-2 text-sm leading-6 text-slate-400">
                Diseño de gráficos y layout orientados a lectura rápida.
              </p>
            </div>

            <div class="rounded-2xl bg-slate-950/60 p-5">
              <p class="font-semibold text-white">Power BI</p>
              <p class="mt-2 text-sm leading-6 text-slate-400">
                Construcción de dashboard interactivo con filtros dinámicos.
              </p>
            </div>

            <div class="rounded-2xl bg-slate-950/60 p-5">
              <p class="font-semibold text-white">DAX</p>
              <p class="mt-2 text-sm leading-6 text-slate-400">
                Creación de medidas para ingresos, ventas y ticket promedio.
              </p>
            </div>

            <div class="rounded-2xl bg-slate-950/60 p-5">
              <p class="font-semibold text-white">Comunicación de datos</p>
              <p class="mt-2 text-sm leading-6 text-slate-400">
                Transformación de datos en información clara para la toma de decisiones.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
        <div class="rounded-3xl border border-cyan-400/20 bg-cyan-400/10 p-8 text-center shadow-2xl shadow-cyan-950/20">
          <h2 class="text-3xl font-bold text-white">
            Explora el dashboard interactivo
          </h2>

          <p class="mx-auto mt-4 max-w-2xl text-slate-300">
            Puedes revisar la versión publicada en Power BI para interactuar con filtros,
            visualizaciones y métricas del proyecto.
          </p>

          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a
              href={dashboardUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-xl bg-cyan-400 px-6 py-3 font-semibold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:bg-cyan-300"
            >
              Abrir dashboard en Power BI
            </a>

            <a
              href="/"
              class="rounded-xl border border-white/10 bg-white/5 px-6 py-3 font-semibold text-slate-200 transition hover:border-cyan-400/60 hover:text-white"
            >
              Volver al portafolio
            </a>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
