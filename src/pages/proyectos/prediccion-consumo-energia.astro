---
import "../../styles/global.css";

const pageUrl =
  "https://camiloacunay.github.io/proyectos/prediccion-consumo-energia/";

const previewImage =
  "https://camiloacunay.github.io/proyectos/prediccion-consumo-energia/IMAGEN.jpg";

const pageTitle =
  "Predicción probabilística de consumo energético con Python | Camilo Acuña";

const pageDescription =
  "Proyecto de forecasting de series temporales con simulaciones Monte Carlo, intervalos de predicción y visualización interactiva en Plotly.";

const chartUrl =
  "/proyectos/prediccion-consumo-energia/grafico_prediccion_consumo_energia_5000.html";

const githubUrl =
  "https://github.com/camiloacunay/prediccion-consumo-energia";

const notebookUrl =
  "https://github.com/camiloacunay/prediccion-consumo-energia/blob/main/notebook/prediccion_consumo_energia.ipynb";

const htmlOutputUrl =
  "https://github.com/camiloacunay/prediccion-consumo-energia/blob/main/outputs/grafico_prediccion_consumo_energia_5000.html";

const dataSourceUrl =
  "https://archive.ics.uci.edu/dataset/374/appliances+energy+prediction";

const kpis = [
  {
    title: "48 horas",
    description: "Ventana histórica utilizada para construir las variables rezagadas del modelo."
  },
  {
    title: "24 horas",
    description: "Horizonte futuro de predicción para estimar el consumo energético esperado."
  },
  {
    title: "5.000",
    description: "Trayectorias simuladas para estimar cuantiles e intervalos de incertidumbre."
  },
  {
    title: "Plotly HTML",
    description: "Visualización interactiva exportada como archivo HTML reutilizable."
  }
];

const metrics = [
  {
    title: "MAE",
    value: "35,40",
    description: "Error absoluto medio del modelo base sobre el conjunto de prueba temporal."
  },
  {
    title: "RMSE",
    value: "55,37",
    description: "Raíz del error cuadrático medio, sensible a errores de mayor magnitud."
  },
  {
    title: "Modelo base",
    value: "Ridge",
    description: "Regresión regularizada utilizada como baseline multivariable interpretable."
  },
  {
    title: "Frecuencia",
    value: "Horaria",
    description: "Los datos originales fueron agregados desde intervalos de 10 minutos a 1 hora."
  }
];

const processSteps = [
  {
    number: "01",
    title: "Obtención de datos",
    description:
      "Descarga de la base Appliances Energy Prediction desde UCI Machine Learning Repository, con registros de consumo energético, variables ambientales y condiciones meteorológicas."
  },
  {
    number: "02",
    title: "Preparación temporal",
    description:
      "Conversión de la fecha a índice temporal, ordenamiento cronológico y agregación de observaciones desde frecuencia de 10 minutos a frecuencia horaria."
  },
  {
    number: "03",
    title: "Ingeniería de variables",
    description:
      "Construcción de rezagos para representar una ventana histórica de 48 horas, medias móviles y variables calendario mediante transformaciones seno/coseno."
  },
  {
    number: "04",
    title: "Modelamiento predictivo",
    description:
      "Entrenamiento de un modelo Ridge multivariable usando variables históricas del consumo y variables externas como temperatura, humedad, viento y visibilidad."
  },
  {
    number: "05",
    title: "Simulación de incertidumbre",
    description:
      "Generación de trayectorias futuras mediante remuestreo de residuos para estimar escenarios plausibles y cuantiles de predicción."
  },
  {
    number: "06",
    title: "Visualización interactiva",
    description:
      "Construcción de un gráfico interactivo en Plotly con histórico observado, horizonte futuro, trayectorias simuladas, bandas de incertidumbre e histograma final."
  }
];

const skills = [
  {
    title: "Forecasting de series temporales",
    description:
      "Formulación del problema como predicción temporal con ventana histórica, horizonte futuro y separación train/test respetando el orden cronológico."
  },
  {
    title: "Feature engineering",
    description:
      "Creación de rezagos, medias móviles, variables calendario y variables externas para capturar patrones temporales y factores explicativos."
  },
  {
    title: "Evaluación de modelos",
    description:
      "Uso de métricas MAE y RMSE para medir desempeño predictivo sobre datos no observados por el modelo durante el entrenamiento."
  },
  {
    title: "Predicción probabilística",
    description:
      "Estimación de incertidumbre mediante trayectorias simuladas e intervalos de predicción en lugar de entregar solo un valor puntual."
  },
  {
    title: "Visualización avanzada",
    description:
      "Diseño de una visualización interactiva con Plotly, combinando serie temporal, intervalos, escenarios y distribución final."
  },
  {
    title: "Comunicación técnica",
    description:
      "Transformación de un flujo analítico en una pieza de portafolio comprensible para audiencias técnicas y de negocio."
  }
];

const techStack = [
  "Python",
  "Pandas",
  "NumPy",
  "Scikit-learn",
  "Plotly",
  "Google Colab",
  "Series temporales",
  "Monte Carlo",
  "HTML interactivo"
];
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />

  <!-- Open Graph / LinkedIn -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:image" content={previewImage} />
  <meta property="og:image:secure_url" content={previewImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:site_name" content="Camilo Acuña | Portafolio" />
  <meta property="og:locale" content="es_CL" />

  <!-- Twitter / generic social preview -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={previewImage} />

  <link rel="canonical" href={pageUrl} />
</head>

  <body class="min-h-screen bg-[#080D18] text-slate-100 antialiased">
    <main class="min-h-screen overflow-hidden bg-[radial-gradient(circle_at_top_left,rgba(14,165,233,0.20),transparent_34%),radial-gradient(circle_at_top_right,rgba(16,185,129,0.16),transparent_32%),linear-gradient(180deg,#080D18_0%,#0F172A_50%,#080D18_100%)]">
      
      <!-- Header -->
      <header class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-8">
        <a
          href="/"
          class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-300 transition hover:border-sky-400/50 hover:text-white"
        >
          ← Volver al portafolio
        </a>

        <a
          href="/CV_Camilo_A.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-300 transition hover:border-sky-400/50 hover:text-white"
        >
          Ver CV
        </a>
      </header>

      <!-- Hero -->
      <section class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-12 lg:grid-cols-[0.95fr_1.05fr] lg:px-8 lg:py-20">
        <div>
          <p class="mb-5 inline-flex rounded-full border border-sky-400/30 bg-sky-400/10 px-4 py-2 text-sm font-semibold text-sky-300">
            Python · Series temporales · Forecasting · Plotly
          </p>

          <h1 class="max-w-4xl text-4xl font-bold tracking-tight text-white md:text-6xl">
            Predicción Probabilística de Consumo Energético
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
            Proyecto de forecasting aplicado al consumo energético, desarrollado con Python
            a partir de datos públicos. El objetivo fue construir una visualización interactiva
            que permitiera estimar el consumo futuro, representar escenarios plausibles y
            cuantificar la incertidumbre mediante trayectorias simuladas e intervalos de predicción.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            {techStack.map((item) => (
              <span class="rounded-full bg-white/10 px-4 py-2 text-sm text-slate-200">
                {item}
              </span>
            ))}
          </div>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href="#grafico"
              class="rounded-xl bg-sky-400 px-5 py-3 font-semibold text-slate-950 shadow-lg shadow-sky-500/20 transition hover:bg-sky-300"
            >
              Ver gráfico interactivo
            </a>

            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-xl border border-white/10 bg-white/5 px-5 py-3 font-semibold text-slate-200 transition hover:border-sky-400/60 hover:text-white"
            >
              Ver repositorio
            </a>

            <a
              href={notebookUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-xl border border-white/10 bg-white/5 px-5 py-3 font-semibold text-slate-200 transition hover:border-sky-400/60 hover:text-white"
            >
              Ver notebook
            </a>
          </div>
        </div>

        <!-- Hero visual card -->
        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-6 shadow-2xl shadow-black/40">
          <div class="rounded-2xl border border-white/10 bg-slate-950/80 p-6">
            <p class="text-sm font-semibold uppercase tracking-widest text-sky-300">
              Resultado principal
            </p>

            <h2 class="mt-4 text-2xl font-bold text-white">
              Forecasting con incertidumbre
            </h2>

            <p class="mt-4 leading-7 text-slate-300">
              A diferencia de una predicción puntual, el proyecto estima un rango de escenarios
              futuros. Esto permite observar la trayectoria esperada, los límites probables del
              consumo y la distribución del resultado al final del horizonte.
            </p>

            <div class="mt-8 grid gap-4 sm:grid-cols-2">
              <div class="rounded-2xl bg-white/[0.05] p-5">
                <p class="text-sm text-slate-400">Ventana histórica</p>
                <p class="mt-2 text-3xl font-bold text-white">48h</p>
              </div>

              <div class="rounded-2xl bg-white/[0.05] p-5">
                <p class="text-sm text-slate-400">Horizonte futuro</p>
                <p class="mt-2 text-3xl font-bold text-white">24h</p>
              </div>

              <div class="rounded-2xl bg-white/[0.05] p-5">
                <p class="text-sm text-slate-400">Simulaciones</p>
                <p class="mt-2 text-3xl font-bold text-white">5.000</p>
              </div>

              <div class="rounded-2xl bg-white/[0.05] p-5">
                <p class="text-sm text-slate-400">Modelo base</p>
                <p class="mt-2 text-3xl font-bold text-white">Ridge</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Summary cards -->
      <section class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
        <div class="grid gap-4 md:grid-cols-4">
          {kpis.map((kpi) => (
            <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-5">
              <p class="text-sm text-slate-400">{kpi.description}</p>
              <p class="mt-3 text-2xl font-bold text-white">{kpi.title}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Interactive chart -->
      <section id="grafico" class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
        <div class="mb-8">
          <p class="text-sm font-semibold uppercase tracking-widest text-sky-300">
            Visualización interactiva
          </p>

          <h2 class="mt-3 text-3xl font-bold text-white">
            Predicción con trayectorias, cuantiles e histograma final
          </h2>

          <p class="mt-4 max-w-4xl leading-8 text-slate-300">
            El gráfico muestra el consumo observado durante las 48 horas previas, el horizonte
            futuro de 24 horas, trayectorias simuladas, intervalos de predicción del 50% y 90%,
            pronóstico medio, mediana simulada, valor real observado y la distribución esperada
            al final del horizonte.
          </p>
        </div>

        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-3 shadow-2xl shadow-black/40">
          <div class="overflow-hidden rounded-2xl border border-white/10 bg-white">
            <iframe
              title="Predicción probabilística de consumo energético"
              src={chartUrl}
              class="h-[520px] w-full md:h-[650px] lg:h-[720px]"
              frameborder="0"
              loading="lazy"
            >
            </iframe>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-4 px-2 pt-4">
            <p class="text-sm text-slate-400">
              Gráfico interactivo generado con Plotly y exportado como HTML.
            </p>

            <a
              href={chartUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-xl border border-sky-400/30 bg-sky-400/10 px-4 py-2 text-sm font-semibold text-sky-300 transition hover:border-sky-400/70 hover:bg-sky-400/20"
            >
              Abrir en pantalla completa
            </a>
          </div>
        </div>
      </section>

      <!-- Context -->
      <section class="mx-auto grid max-w-7xl gap-8 px-6 py-12 lg:grid-cols-[0.75fr_1.25fr] lg:px-8">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-sky-300">Contexto</p>
          <h2 class="mt-3 text-3xl font-bold text-white">Problema abordado</h2>
        </div>

        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-8">
          <p class="leading-8 text-slate-300">
            En problemas de consumo energético, una predicción puntual puede ser insuficiente
            para la toma de decisiones. La demanda puede variar por patrones horarios, condiciones
            ambientales, hábitos de uso y eventos atípicos. Por eso, el proyecto se enfocó en
            construir una predicción probabilística capaz de mostrar no solo un valor esperado,
            sino también un rango de escenarios posibles.
          </p>

          <p class="mt-5 leading-8 text-slate-300">
            La visualización resultante permite observar cómo evoluciona la incertidumbre dentro
            del horizonte futuro, identificar momentos de mayor variabilidad esperada y comparar
            la predicción contra el valor real observado.
          </p>
        </div>
      </section>

      <!-- Data source -->
      <section id="fuentes" class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-8">
          <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-sky-300">
                Fuente de datos
              </p>

              <h2 class="mt-3 text-3xl font-bold text-white">
                Appliances Energy Prediction
              </h2>

              <p class="mt-4 leading-8 text-slate-300">
                El proyecto utiliza una base pública de UCI Machine Learning Repository con
                registros de consumo energético de electrodomésticos y variables ambientales
                asociadas.
              </p>

              <a
                href={dataSourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-flex rounded-xl border border-sky-400/30 bg-sky-400/10 px-4 py-2 text-sm font-semibold text-sky-300 transition hover:border-sky-400/70 hover:bg-sky-400/20"
              >
                Ver fuente original
              </a>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-2xl border border-white/10 bg-slate-950/60 p-5">
                <p class="text-sm text-slate-400">Variable objetivo</p>
                <p class="mt-2 font-semibold text-white">Consumo energético</p>
              </div>

              <div class="rounded-2xl border border-white/10 bg-slate-950/60 p-5">
                <p class="text-sm text-slate-400">Variables externas</p>
                <p class="mt-2 font-semibold text-white">Temperatura, humedad, viento y visibilidad</p>
              </div>

              <div class="rounded-2xl border border-white/10 bg-slate-950/60 p-5">
                <p class="text-sm text-slate-400">Granularidad original</p>
                <p class="mt-2 font-semibold text-white">10 minutos</p>
              </div>

              <div class="rounded-2xl border border-white/10 bg-slate-950/60 p-5">
                <p class="text-sm text-slate-400">Granularidad modelada</p>
                <p class="mt-2 font-semibold text-white">1 hora</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Metrics -->
      <section class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-8">
          <div class="mb-8">
            <p class="text-sm font-semibold uppercase tracking-widest text-sky-300">
              Evaluación
            </p>

            <h2 class="mt-3 text-3xl font-bold text-white">
              Métricas y configuración del modelo
            </h2>

            <p class="mt-4 max-w-3xl text-slate-400">
              El modelo fue evaluado sobre un conjunto de prueba temporal, evitando mezclar
              observaciones futuras en el entrenamiento.
            </p>
          </div>

          <div class="grid gap-4 md:grid-cols-4">
            {metrics.map((metric) => (
              <div class="rounded-2xl border border-white/10 bg-slate-950/60 p-5">
                <p class="text-sm text-slate-400">{metric.title}</p>
                <p class="mt-3 text-3xl font-bold text-white">{metric.value}</p>
                <p class="mt-3 text-sm leading-6 text-slate-400">{metric.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Technical process -->
      <section id="proceso" class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
        <div class="mb-10">
          <p class="text-sm font-semibold uppercase tracking-widest text-sky-300">
            Proceso técnico
          </p>

          <h2 class="mt-3 text-3xl font-bold text-white">
            De datos temporales a predicción probabilística
          </h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {processSteps.map((step) => (
            <article class="rounded-3xl border border-white/10 bg-white/[0.04] p-7 transition hover:border-sky-400/40 hover:bg-white/[0.07]">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-sky-400 text-sm font-bold text-slate-950">
                {step.number}
              </div>

              <h3 class="mt-5 text-xl font-semibold text-white">{step.title}</h3>

              <p class="mt-3 leading-7 text-slate-300">
                {step.description}
              </p>
            </article>
          ))}
        </div>
      </section>

      <!-- Methodology -->
      <section class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
        <div class="grid gap-8 lg:grid-cols-2">
          <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-8">
            <p class="text-sm font-semibold uppercase tracking-widest text-sky-300">
              Metodología
            </p>

            <h2 class="mt-3 text-3xl font-bold text-white">
              Cómo se estimó la incertidumbre
            </h2>

            <p class="mt-6 leading-8 text-slate-300">
              Primero se entrenó un modelo base para obtener una predicción central. Luego se
              calcularon residuos sobre un conjunto de validación temporal. Estos residuos fueron
              remuestreados para generar múltiples trayectorias futuras plausibles, manteniendo
              la estructura recursiva del pronóstico.
            </p>

            <p class="mt-5 leading-8 text-slate-300">
              A partir de las trayectorias simuladas se calcularon cuantiles P05, P25, P50, P75
              y P95. Con estos cuantiles se construyeron las bandas de predicción del 50% y 90%,
              junto con la mediana simulada y el histograma de distribución al final del horizonte.
            </p>
          </div>

          <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-8">
            <p class="text-sm font-semibold uppercase tracking-widest text-sky-300">
              Resultado
            </p>

            <h2 class="mt-3 text-3xl font-bold text-white">
              Valor del proyecto
            </h2>

            <p class="mt-6 leading-8 text-slate-300">
              El resultado permite comunicar de manera visual que una predicción energética
              no debe interpretarse como un único valor exacto, sino como un rango de escenarios
              probables. Esto es especialmente útil para planificación operativa, gestión de
              demanda y análisis de riesgo.
            </p>

            <div class="mt-8 rounded-2xl border border-sky-400/20 bg-sky-400/10 p-5">
              <p class="font-semibold text-sky-200">Lectura ejecutiva</p>
              <p class="mt-2 leading-7 text-slate-300">
                El gráfico permite ver cuándo la predicción es más estable, cuándo aumenta la
                incertidumbre y qué tan lejos se ubica el valor real respecto de los escenarios
                simulados.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Skills applied -->
      <section class="mx-auto max-w-7xl px-6 py-8 lg:px-8">
        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-8">
          <p class="text-sm font-semibold uppercase tracking-widest text-sky-300">
            Competencias aplicadas
          </p>

          <h2 class="mt-3 text-3xl font-bold text-white">
            Qué demuestra este proyecto
          </h2>

          <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {skills.map((skill) => (
              <div class="rounded-2xl bg-slate-950/60 p-5">
                <p class="font-semibold text-white">{skill.title}</p>
                <p class="mt-2 text-sm leading-6 text-slate-400">
                  {skill.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Repository links -->
      <section class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
        <div class="rounded-3xl border border-white/10 bg-gradient-to-r from-sky-400/15 to-emerald-400/10 p-8">
          <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-sky-300">
                Repositorio técnico
              </p>

              <h2 class="mt-3 text-3xl font-bold text-white">
                Código, notebook y visualización exportada
              </h2>

              <p class="mt-4 max-w-3xl leading-8 text-slate-300">
                El repositorio contiene el notebook del análisis, el archivo HTML interactivo,
                la imagen de vista previa, dependencias del entorno y documentación del proyecto.
              </p>
            </div>

            <div class="flex flex-wrap gap-4 lg:justify-end">
              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-xl bg-sky-400 px-5 py-3 font-semibold text-slate-950 shadow-lg shadow-sky-500/20 transition hover:bg-sky-300"
              >
                Ver GitHub
              </a>

              <a
                href={notebookUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-xl border border-white/10 bg-white/5 px-5 py-3 font-semibold text-slate-200 transition hover:border-sky-400/60 hover:text-white"
              >
                Ver notebook
              </a>

              <a
                href={htmlOutputUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-xl border border-white/10 bg-white/5 px-5 py-3 font-semibold text-slate-200 transition hover:border-sky-400/60 hover:text-white"
              >
                Ver HTML
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- LinkedIn preparation -->
      <section class="mx-auto max-w-7xl px-6 py-8 pb-20 lg:px-8">
        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-8">
          <p class="text-sm font-semibold uppercase tracking-widest text-sky-300">
            Próxima publicación
          </p>

          <h2 class="mt-3 text-3xl font-bold text-white">
            Preparado para storytelling en LinkedIn
          </h2>

          <p class="mt-5 max-w-4xl leading-8 text-slate-300">
            Este proyecto puede convertirse en una publicación orientada a explicar cómo pasar
            de una serie temporal energética a una predicción probabilística interpretable,
            destacando el valor de cuantificar incertidumbre para apoyar decisiones operativas
            y analíticas.
          </p>
        </div>
      </section>
    </main>
  </body>
</html>
